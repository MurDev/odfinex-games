# Copy to .env and adjust values.
# Local Postgres: docker compose up -d

DATABASE_URL=postgresql://odfinex:odfinex@localhost:55432/odfinex_games

# API (apps/api)
PORT=4000

# App URLs (Phase 1+)
WEB_URL=http://localhost:3000
PLAY_URL=http://localhost:3001
API_URL=http://localhost:4000
# Browser origins allowed to call the API (external games)
CORS_ORIGINS=http://localhost:3002,http://localhost:3005

# Auth.js (Phase 1 — Google OAuth par défaut)
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MonCash via Bazik (Phase P3).
# Mêmes credentials que LUDOLAKAY (`BAZIK_USER_ID`, `BAZIK_SECRET_KEY`, `BAZIK_WEBHOOK_SECRET`).
# Le webhook n'est PAS configuré dans le dashboard : à chaque createPayment on envoie
# `webhookUrl` dans la requête (ex. https://<api>/webhooks/bazik). Ludolakay et Odfinex
# peuvent donc coexister sur le même compte Bazik — chaque dépôt route vers son propre serveur.
# Sans credentials, l'API utilise des dépôts mock / withdraw dry-run en local.
BAZIK_API_URL=https://api.bazik.io
BAZIK_USER_ID=
BAZIK_SECRET_KEY=
BAZIK_WEBHOOK_SECRET=
# Force mock even if credentials exist (local only)
# BAZIK_MOCK=true
# Skip real MonCash payouts
# BAZIK_WITHDRAW_DRY_RUN=true
